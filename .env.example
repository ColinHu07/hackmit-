# Server only. Never put credentials in VITE_* variables or the phone app.
MODEL_API_KEY=
# Copy the exact versioned API base URL and vision model ID from your Meta dashboard.
# Adapter expects an OpenAI-compatible /chat/completions API with image_url inputs.
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3
# For phones on the same Wi-Fi:
HOST=0.0.0.0
PORT=8788

{
  "name": "bondimals",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "glasses-web",
    "companion-web",
    "bridge"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @bondimals/glasses-web",
    "build": "npm run build --workspace @bondimals/glasses-web && node scripts/stage-display.mjs",
    "test": "npm run test --workspace @bondimals/glasses-web && npm run test --workspace @bondimals/bridge",
    "typecheck": "npm run typecheck --workspace @bondimals/glasses-web",
    "preview": "npm run preview --workspace @bondimals/glasses-web",
    "bridge": "npm run start --workspace @bondimals/bridge",
    "dev:phone": "npm run dev --workspace @bondimals/companion-web",
    "build:phone": "npm run build --workspace @bondimals/companion-web",
    "preview:phone": "npm run preview --workspace @bondimals/companion-web",
    "web:start": "node --import ./scripts/load-env.mjs bridge/play-server.mjs --web",
    "web:share": "node scripts/share-phone-web.mjs",
    "test:multiplayer": "node scripts/test-phone-multiplayer.mjs",
    "test:web-proxy": "node --test scripts/phone-web-proxy.test.mjs",
    "typecheck:phone": "npm run typecheck --workspace @bondimals/companion-web",
    "play:server": "node --import ./scripts/load-env.mjs bridge/play-server.mjs",
    "test:phone": "node --test bridge/play-server.test.mjs bridge/pet-store.test.mjs bridge/nearby-discovery.test.mjs bridge/quest-verification.test.mjs bridge/static-web.test.mjs bridge/glasses-camera.test.mjs && npm run test --workspace @bondimals/companion-web",
    "check:meta": "node --import ./scripts/load-env.mjs scripts/check-meta.mjs",
    "build:all": "npm run build:phone && npm run build --workspace @bondimals/glasses-web -- --base=/glasses/ && node scripts/stage-glasses-game.mjs",
    "build:camera": "node scripts/build-glasses-camera.mjs"
  }
}
